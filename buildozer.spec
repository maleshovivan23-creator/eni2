[app]
title = ENI
package.name = eni
package.domain = org.eni
version = 0.1.0
source.dir = .
source.include_exts = py
requirements = python3,kivy
orientation = portrait
fullscreen = 0
android.permissions = INTERNET,ACCESS_NETWORK_STATE
android.archs = arm64-v8a
android.api = 33
android.minapi = 21

[buildozer]
log_level = 2
warn_on_root = 1
